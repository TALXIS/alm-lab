<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tests.UI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
    <PackageReference Include="Microsoft.Playwright.MSTest" Version="1.61.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.3" />
    <PackageReference Include="Reqnroll" Version="3.3.4" />
    <PackageReference Include="Reqnroll.MsTest" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <!--
    Features/Discovered/ is where the black-box exploration agent drops what it finds. It is
    unvetted by construction: nothing there has step bindings, so Reqnroll's default glob
    (ReqnrollFeatureFile Include="**\*.feature", in its .props) compiles each one into a test
    that fails on the first undefined step. Five of them turned a green suite red the first time
    the agent actually ran.

    Removing them here works because the glob is in a .props, which is imported before this file.
    They stay listed as None so they are still visible in the IDE and in source control - they
    are the point of the exercise, they just are not tests until a human promotes one into
    Features/ and binds it.
  -->
  <ItemGroup>
    <ReqnrollFeatureFile Remove="Features/Discovered/**/*.feature" />
    <None Include="Features/Discovered/**/*.feature" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="reqnroll.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
