# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
.vscode/settings.json
.vscode/launch.json

# Test Results
TestResults/
*.trx
*.coverage

# Reqnroll/SpecFlow generated files
*.feature.cs
# Reqnroll's local anonymous-telemetry marker (Reqnroll/userid), always written to disk on
# first build regardless of REQNROLL_TELEMETRY_ENABLED — that variable only gates the
# outbound network send, not local id-file creation.
Reqnroll/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Playwright
.playwright/
playwright-auth-state.encrypted
# A saved Playwright storage state is a live signed-in session (cookies and tokens) - never
# commit one. Point TestSettings:StorageStatePath or TXC_STORAGE_STATE_PATH at it instead.
auth-state.json
*auth-state.json
# Cached sessions written by the "I am logged in as" step, one file per account.
.auth/

# Credentials for that step. .env.example is the committed template.
.env
!.env.example

# NuGet
*.nupkg
*.snupkg
packages/
!**/packages/build/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
.idea/
*.sln.iml

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

.playwright-mcp