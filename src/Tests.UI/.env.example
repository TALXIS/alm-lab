# Copy to .env (gitignored) and fill in. Never commit the copy.
#
# The persona in a feature file's "Given I am logged in as '<persona>'" becomes the variable
# name. Articles (a / an / the) are dropped:
#
#   'a warehouse manager'      -> TXC_USER_WAREHOUSE_MANAGER_...
#   'a warehouse floor worker' -> TXC_USER_WAREHOUSE_FLOOR_WORKER_...
#
# Real environment variables always win over this file, so CI passes the same names as secrets
# and needs no .env at all.

TXC_USER_WAREHOUSE_MANAGER_USERNAME=someone@yourtenant.onmicrosoft.com
TXC_USER_WAREHOUSE_MANAGER_PASSWORD=

# If the account has MFA, put its authenticator seed here and the six digits are generated on
# every run - this is what makes a headless run possible at all on an MFA-protected tenant.
# The seed is the base32 string shown beside the QR code when you add an authenticator app.
# Use it only for a test account with no standing access to anything.
# TXC_USER_WAREHOUSE_MANAGER_OTP_SECRET=

# One account for every persona, instead of per-persona variables:
# TXC_USER_USERNAME=someone@yourtenant.onmicrosoft.com
# TXC_USER_PASSWORD=
# TXC_USER_OTP_SECRET=

# MS_AUTH_EMAIL / MS_USER_PASSWORD are read too, so a .env from Microsoft's
# power-platform-playwright-samples works here unchanged.

# Which environment the scenarios run against (overrides appsettings.json).
# TXC_ENVIRONMENT_URL=https://yourenv.crm4.dynamics.com/

# Run with a visible browser - needed once if MFA asks for something a seed cannot answer.
# TXC_HEADLESS=false

# Where cached sessions are written. Default: src/Tests.UI/.auth/
# TXC_AUTH_DIR=
