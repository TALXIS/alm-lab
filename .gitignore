# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo

# Test output
TestResults/
[Tt]est[Rr]esult*/

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# OS
.DS_Store
Thumbs.db

# Lab note: .lab-state.json is intentionally committed so progress survives crashes.

# Claude Code session worktrees (nested git checkouts, not project content)
.claude/

# Terraform (see infra/README.md — state is local-only, no remote backend)
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Node dependencies (restored with npm ci; note the blanket [Bb]in/ rule above would
# otherwise commit these without each package's bin/ folder, leaving dangling .bin symlinks)
node_modules/
